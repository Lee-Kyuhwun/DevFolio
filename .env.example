# ImpactNote 로컬 환경 예시. 실제 키를 이 파일에 커밋하지 마세요.
# `cp .env.example .env` 후 필요한 값만 채웁니다. .env 는 .gitignore 대상입니다.

# --- AI Provider (선택) ---
# 외부 AI 전송은 앱 설정에서 동의해야 동작합니다. 키가 없어도 기록·보고서 기능은 동작합니다.
# NVIDIA NIM: https://build.nvidia.com/settings/api-keys 에서 발급
NVIDIA_NIM_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- 저장 위치 (선택) ---
# 기본값은 OS 별 platformdirs 경로를 사용합니다.
# IMPACTNOTE_DATA_DIR=
# IMPACTNOTE_CONFIG_DIR=

# --- Docker (선택) ---
# 호스트 포트를 바꿀 때 사용합니다.
# IMPACTNOTE_PORT=8000
# 컨테이너가 읽기 전용으로 마운트할 저장소 상위 경로. 기본값은 현재 디렉터리.
# REPOS_DIR=.

# --- 분석 경로 allowlist (선택) ---
# 호스트에서 실행할 때 분석 API 가 접근할 수 있는 경로를 제한합니다.
# IMPACTNOTE_ANALYZE_ROOTS=
